# ──────────────────────────────────────────────────────────────
# Chain setup
# Alto is currently only on Ethereum Mainnet (chain ID 1).
# All per-chain variables follow the pattern VARIABLE_{CHAIN_ID}.
# ──────────────────────────────────────────────────────────────

# RPC URL for the target chain. Required for the bot to operate on that chain.
# If not set, the chain is skipped.
RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# Address of the deployed Executor contract on the target chain
EXECUTOR_ADDRESS_1=0x...

# Private key of the wallet that owns / operates the Executor
LIQUIDATION_PRIVATE_KEY_1=0x...

# ──────────────────────────────────────────────────────────────
# Indexer connection
# ──────────────────────────────────────────────────────────────

# URL of the Ponder indexer API. Defaults to http://localhost:42069 if not set.
# PONDER_SERVICE_URL=http://localhost:42069

# ──────────────────────────────────────────────────────────────
# Liquidity venue API keys (all optional)
# ──────────────────────────────────────────────────────────────

# 1inch Swap API key for the 1inch venue
# ONE_INCH_SWAP_API_KEY=

# Odos API key. The public endpoint works without it; enterprise access can use this header.
# ODOS_API_KEY=

# ──────────────────────────────────────────────────────────────
# Flashbots (optional)
# ──────────────────────────────────────────────────────────────

# Private key used to sign Flashbots bundles. When set, transactions are sent via Flashbots.
# FLASHBOTS_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────
# Behavior flags (optional)
# ──────────────────────────────────────────────────────────────

# When "true", skips the profitability check and submits liquidations regardless.
# SKIP_CHECK_FOR_PROFIT=false

# When "1", logs a debug_traceCall for every failed simulation to help diagnose reverts.
# DEBUG_LIQUIDATION=0
